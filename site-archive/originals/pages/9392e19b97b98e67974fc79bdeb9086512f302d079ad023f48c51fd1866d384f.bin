										<img class="sigProImg" src="/plugins/content/jw_sigpro/jw_sigpro/includes/images/transparent.gif" alt="Click to enlarge image reznoi_potolok_v_armstrong_bez_podsvetki.jpg" title="Click to enlarge image reznoi_potolok_v_armstrong_bez_podsvetki.jpg" style="width:200px;height:160px;background-image:url(/cache/jw_sigpro/jwsigpro_cache_3037df0746_reznoi_potolok_v_armstrong_bez_podsvetki.jpg);" />
														</a>
			</span>
		</span>
	</li>
		<li class="sigProThumb">
		<span class="sigProLinkOuterWrapper">
