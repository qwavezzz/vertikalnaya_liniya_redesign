.slide-desc-bg {
	
	opacity: 0.6;
	filter: alpha(opacity = 60);
}
.slide-desc-text {
	color: #fff;
	padding: 10px;
	text-align: left;
}
.slide-desc-text .slide-title {
	font-size: 14px;
	color: #fff;
	margin-bottom: 5px;	    margin-left: auto;    margin-right: auto;    display: block;    width: 100%;    text-align: center;

}
.slide-desc-text .slide-title a {
	color: #030303;
    font-size: 14px !important;
font-size: 14px;
}
.djslider .navigation-container a {
	outline: none;
}
.djslider-loader {
	background: url(loader.gif) center center no-repeat;
}

.djslider li {
	text-align: center;
}

span.load-button {
	width: 12px;
	height: 12px;
	display: inline-block;
	background: #222;
	border: 1px solid #fff;
	box-shadow: 0 0 2px #fff;
	margin: 0 3px;
	cursor: pointer;
	border-radius: 7px;
	opacity: 0.4;
	filter: alpha(opacity = 40);
}
span.load-button-active {
	opacity: 0.8;
	filter: alpha(opacity = 80);
}

